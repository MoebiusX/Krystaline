# Secret values for local deployment - DO NOT COMMIT
# This file is gitignored. Pass these via: helm upgrade --set or -f values-secrets.yaml
secrets:
  create: true
  dbPassword: ""
  rabbitmqPassword: ""
  jwtSecret: ""
  kongDbPassword: ""
  grafanaAdminPassword: ""
  goalertDbPassword: ""
  goalertEncryptionKey: ""
  mailgunApiKey: ""

# otel-mcp-server API keys (role-based auth). agentKey and rcaKey are required.
# Generate with: openssl rand -hex 16  (prefix with sk-kx-<role>- for readability)
otelMcpServer:
  auth:
    agentKey: ""
    rcaKey: ""
    traderKey: ""
    businessKey: ""
    productKey: ""

goalert:
  integrationTokens:
    # printed by scripts/provision-goalert.sh
    general: ""
    critical: ""
    security: ""
